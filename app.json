{
  "expo": {
    "name": "Tocah",
    "slug": "tocah-do-coelho-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A1B9A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6A1B9A"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Tocah",
      "shortName": "Tocah",
      "display": "standalone",
      "themeColor": "#6a1b9a",
      "backgroundColor": "#F6F4FA",
      "lang": "pt-BR",
      "description": "App da República Tocah do Coelho: finanças, tarefas, Nilde e feed da casa."
    }
  }
}
